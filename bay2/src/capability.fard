import("std/json") as json
import("std/str") as str
import("std/rec") as rec
import("std/list") as list
import("std/hash") as hash
import("std/crypto") as crypto

// Bay2 Capability — scoped bearer tokens for object access.
// A capability grants a specific right over a specific resource namespace.
// Capabilities are signed by the issuer and verifiable by any node.
// Capabilities can be attenuated — a holder can issue a sub-capability
// with equal or narrower scope, never broader.
//
// Rights: read | write | append | admin | witness | replicate
// Resource: a namespace prefix e.g. "stream:s1", "object:*", "stream:*"

fn make_capability(issuer_id, holder_id, resource, rights, expires_unix_secs, nonce) {
  {
    issuer_id: issuer_id,
    holder_id: holder_id,
    resource: resource,
    rights: rights,
    expires_unix_secs: expires_unix_secs,
    nonce: nonce
  }
}

fn capability_digest(cap) {
  hash.sha256_text(json.canonicalize({
    issuer_id: cap.issuer_id,
    holder_id: cap.holder_id,
    resource: cap.resource,
    rights: cap.rights,
    expires_unix_secs: cap.expires_unix_secs,
    nonce: cap.nonce
  }))
}

fn sign_capability(cap, issuer_private_key_hex) {
  let digest = capability_digest(cap) in
  let raw = str.slice(digest, 7, str.len(digest)) in
  let sig = crypto.ed25519_sign(issuer_private_key_hex, raw) in
  { capability: cap, digest_hex: digest, signature_hex: sig }
}

fn verify_capability(envelope, issuer_public_key_hex) {
  let digest_ok = capability_digest(envelope.capability) == envelope.digest_hex in
  let sig_ok = if digest_ok then
    let raw = str.slice(envelope.digest_hex, 7, str.len(envelope.digest_hex)) in
    crypto.ed25519_verify(issuer_public_key_hex, raw, envelope.signature_hex)
  else false in
  { valid: digest_ok && sig_ok, digest_ok: digest_ok, signature_ok: sig_ok }
}

fn has_right(cap, right) {
  list.any(cap.rights, fn(r) { r == right || r == "admin" })
}

fn resource_matches(cap_resource, requested_resource) {
  if str.ends_with(cap_resource, "*") then
    let prefix = str.slice(cap_resource, 0, str.len(cap_resource) - 1) in
    str.starts_with(requested_resource, prefix)
  else
    cap_resource == requested_resource
}

fn is_valid_for(cap, holder_id, resource, right, now_unix_secs) {
  cap.holder_id == holder_id &&
  resource_matches(cap.resource, resource) &&
  has_right(cap, right) &&
  (cap.expires_unix_secs == 0 || cap.expires_unix_secs > now_unix_secs)
}

fn attenuate(parent_cap, new_holder_id, new_resource, new_rights, new_expires, nonce) {
  let resource_ok = resource_matches(parent_cap.resource, new_resource) || new_resource == parent_cap.resource in
  let rights_ok = list.all(new_rights, fn(r) { has_right(parent_cap, r) }) in
  let expires_ok = parent_cap.expires_unix_secs == 0 ||
    (new_expires != 0 && new_expires <= parent_cap.expires_unix_secs) in
  if !resource_ok then { ok: false, reason: "resource exceeds parent scope" }
  else if !rights_ok then { ok: false, reason: "rights exceed parent scope" }
  else if !expires_ok then { ok: false, reason: "expiry exceeds parent expiry" }
  else
    let child = make_capability(parent_cap.holder_id, new_holder_id, new_resource, new_rights, new_expires, nonce) in
    { ok: true, capability: child }
}

fn empty_capability_store() {
  { capabilities: {}, revoked: [] }
}

fn store_capability(cap_store, envelope) {
  let digest = envelope.digest_hex in
  { ...cap_store, capabilities: rec.set(cap_store.capabilities, digest, envelope) }
}

fn revoke_capability(cap_store, digest_hex) {
  if list.any(cap_store.revoked, fn(d) { d == digest_hex }) then cap_store
  else { ...cap_store, revoked: list.append(cap_store.revoked, digest_hex) }
}

fn is_revoked(cap_store, digest_hex) {
  list.any(cap_store.revoked, fn(d) { d == digest_hex })
}

fn capability_count(cap_store) {
  list.len(rec.keys(cap_store.capabilities))
}

export { make_capability, capability_digest, sign_capability, verify_capability, has_right, resource_matches, is_valid_for, attenuate, empty_capability_store, store_capability, revoke_capability, is_revoked, capability_count }
